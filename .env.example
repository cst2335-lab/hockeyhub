# GoGoHockey — environment variable names only (no secrets)
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# --- Required for meaningful local data pages ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Required for game view tracking + server/admin scripts ---
# Used by POST /api/games/view (RLS blocks non-owner view_count updates without service role).
# Also used by admin/import scripts. Map SUPABASE_SERVICE_ROLE_KEY → SUPABASE_SERVICE_KEY if needed.
# Leave empty in this example file — put the real key only in .env.local (never commit secrets).
SUPABASE_SERVICE_KEY=

# --- Stripe (optional; booking checkout / webhook — E2E payment not claimed without verification) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Optional integrations ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_NAME=
CRON_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Optional test helpers ---
TEST_LOGIN_USERNAME=
TEST_LOGIN_PASSWORD=
